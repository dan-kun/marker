[Desktop Entry]
Version=1.0
Type=Application
Name=Marker
GenericName=Markdown Editor
Comment=Markdown and TXT viewer/editor
# @LAUNCHER@ is replaced by scripts/install-desktop.sh
Exec=@LAUNCHER@ %F
Icon=io.github.dan_kun.Marker
Terminal=false
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;text/x-markdown;text/plain;
Keywords=markdown;text;editor;viewer;md;
StartupWMClass=io.github.dan_kun.Marker
StartupNotify=true
